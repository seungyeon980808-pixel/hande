# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/vendor/rhwp-studio/node_modules/
/vendor/rhwp-studio/dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private prototype data (never commit real school files)
/.data/
/storage/

# local AI coding-tool settings
/.codex/
/.agents/

# 테스트용 실제 학교 문서 (개인정보 포함 가능 · 저장소에 올리지 않음)
hwpx예시/

# 교체 전 원본 편집기 백업 (로컬 보관용)
public/rhwp-stock-backup/

# 시연자료는 실명·학교명이 든 실물 문서라 리포에 두지 않는다.
시연자료/
