# rHWP 편집기 주소.
# 자체 호스팅본이 public/rhwp/ 에 포함되어 있으므로 아래 값이면 외부 인터넷 없이 동작한다.
# (끝의 index.html 을 빼면 Next.js가 /rhwp 로 리다이렉트해 404가 난다)
NEXT_PUBLIC_RHWP_STUDIO_URL=/rhwp/index.html
DATABASE_URL=postgresql://school:change-me@localhost:5432/school_work
NEIS_API_KEY=your-neis-open-api-key
NEIS_ATPT_OFCDC_SC_CODE=your-education-office-code
NEIS_SD_SCHUL_CODE=your-school-code

# 양식 갱신 AI 제안 (선택) — 없어도 규칙 기반 제안은 그대로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
